DATABRICKS_HOST=https://...
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=app
FLASK_RUN_HOST=0.0.0.0

# Deployment settings. In a deployed app the bundle exports these from the `variables:` in databricks.yml
# (and LAKEBASE_ENDPOINT from the postgres resource). Locally, mirror those values here.
LAKEBASE_ENABLED=true
LAKEBASE_PROJECT=projects/agentic-memory
LAKEBASE_BRANCH=projects/agentic-memory/branches/production
LAKEBASE_DATABASE=projects/agentic-memory/branches/production/databases/databricks-postgres
LAKEBASE_ENDPOINT=projects/agentic-memory/branches/production/endpoints/primary
LAKEBASE_SCHEMA=partner_activation
ADMIN_EMAILS=you@example.com
AI_ENDPOINT_NAME=databricks-meta-llama-3-3-70b-instruct
AI_EMBEDDING_ENDPOINT=databricks-gte-large-en

# Local development only: grants /admin to this address (must be in ADMIN_EMAILS). Ignored in production.
# DEV_ADMIN_EMAIL=you@example.com
